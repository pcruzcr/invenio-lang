// algorithms/searching.inv -- Array searching algorithms
//
// InvenioLang educational standard library (INV-1430).
// Usage:   import "algorithms/searching";
//
// All of them work on the first n elements of the array and return a
// POSITION (0..n-1) or -1 if the value is not there.

// LINEAR: checks one by one. Works on any array. O(n).
int linear_search(int[] a, int n, int x) {
    for (int i = 0; i < n; i++) {
        if (a[i] == x) {
            return i;
        }
    }
    return -1;
}

// BINARY: ONLY for sorted arrays. Compares with the middle element and
// discards the half that cannot contain x. O(log n).
int binary_search(int[] a, int n, int x) {
    int start = 0;
    int end = n - 1;
    while (start <= end) {
        int middle = start + (end - start) / 2;
        if (a[middle] == x) {
            return middle;
        }
        if (a[middle] < x) {
            start = middle + 1;
        } else {
            end = middle - 1;
        }
    }
    return -1;
}

// The same binary search written recursively, over a[start..end].
int recursive_binary_search(int[] a, int start, int end, int x) {
    if (start > end) {
        return -1;
    }
    int middle = start + (end - start) / 2;
    if (a[middle] == x) {
        return middle;
    }
    if (a[middle] < x) {
        return recursive_binary_search(a, middle + 1, end, x);
    }
    return recursive_binary_search(a, start, middle - 1, x);
}

// Position of the largest element (the first one if repeated). O(n).
int index_of_max(int[] a, int n) {
    if (n <= 0) {
        throw_error("index_of_max: the array is empty");
    }
    int best = 0;
    for (int i = 1; i < n; i++) {
        if (a[i] > a[best]) {
            best = i;
        }
    }
    return best;
}

// Position of the smallest element (the first one if repeated). O(n).
int index_of_min(int[] a, int n) {
    if (n <= 0) {
        throw_error("index_of_min: the array is empty");
    }
    int best = 0;
    for (int i = 1; i < n; i++) {
        if (a[i] < a[best]) {
            best = i;
        }
    }
    return best;
}

// How many times x appears. O(n).
int count_occurrences(int[] a, int n, int x) {
    int total = 0;
    for (int i = 0; i < n; i++) {
        if (a[i] == x) {
            total = total + 1;
        }
    }
    return total;
}
