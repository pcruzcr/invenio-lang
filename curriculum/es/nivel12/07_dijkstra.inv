// Nivel 12 · Ejercicio 07 — Caminos mínimos con pesos: Dijkstra
// Objetivos:
//   - Implementar Dijkstra con matriz de pesos
//   - Entender la relajación de aristas
//
constante entero N = 6;
constante entero INF = 1000000;
entero [N][N] pesos;
entero [N] dist;
entero [N] padreDe;

vacio arista(entero a, entero b, entero w) {
    pesos[a][b] = w;
    pesos[b][a] = w;
}

vacio imprimirCamino(entero v) {
    si (padreDe[v] != -1) {
        imprimirCamino(padreDe[v]);
        imprimir("-");
    }
    imprimir(v);
}

vacio main() {
    para (entero i = 0; i < N; i++) {
        para (entero j = 0; j < N; j++) { pesos[i][j] = 0; }
    }
    arista(0, 1, 4); arista(0, 2, 1); arista(2, 1, 2); arista(1, 3, 5);
    arista(2, 3, 8); arista(3, 4, 3); arista(4, 5, 2);

    logico [N] hecho;
    para (entero i = 0; i < N; i++) {
        dist[i] = INF;
        padreDe[i] = -1;
        hecho[i] = falso;
    }
    dist[0] = 0;
    para (entero paso = 0; paso < N; paso++) {
        // Elegir el vértice pendiente más cercano (elección voraz).
        entero u = -1;
        para (entero v = 0; v < N; v++) {
            si (!hecho[v] && (u == -1 || dist[v] < dist[u])) {
                u = v;
            }
        }
        hecho[u] = verdadero;
        para (entero v = 0; v < N; v++) {
            si (pesos[u][v] > 0 && dist[u] + pesos[u][v] < dist[v]) {
                dist[v] = dist[u] + pesos[u][v];   // relajación
                padreDe[v] = u;
            }
        }
    }
    para (entero v = 0; v < N; v++) {
        imprimir(v); imprimir(": "); imprimir(dist[v]); imprimir("  "); imprimirCamino(v); imprimir("\n");
    }
}
