// Nivel 12 · Ejercicio 08 — Orden topológico (Kahn)
// Objetivos:
//   - Modelar dependencias con un grafo dirigido
//   - Implementar el algoritmo de Kahn con grados de entrada
//
constante entero N = 6;
entero [N][N] adj;

vacio main() {
    para (entero i = 0; i < N; i++) {
        para (entero j = 0; j < N; j++) { adj[i][j] = 0; }
    }
    adj[0][2] = 1; adj[1][2] = 1; adj[1][3] = 1;
    adj[2][4] = 1; adj[3][4] = 1; adj[4][5] = 1;

    entero [N] gradoEntrada;
    logico [N] tomado;
    para (entero v = 0; v < N; v++) {
        gradoEntrada[v] = 0;
        tomado[v] = falso;
        para (entero u = 0; u < N; u++) {
            gradoEntrada[v] += adj[u][v];
        }
    }
    imprimir("order:");
    para (entero k = 0; k < N; k++) {
        entero u = -1;
        para (entero v = 0; v < N && u == -1; v++) {
            si (!tomado[v] && gradoEntrada[v] == 0) {
                u = v;   // el menor vértice sin dependencias pendientes
            }
        }
        tomado[u] = verdadero;
        imprimir(" "); imprimir(u);
        para (entero v = 0; v < N; v++) {
            si (adj[u][v] == 1) {
                gradoEntrada[v] = gradoEntrada[v] - 1;
            }
        }
    }
    imprimir("\n");
}
