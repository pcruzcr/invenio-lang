// Nivel 4 · Ejercicio 07 — Invertir en el lugar
// Objetivos:
//   - Usar la técnica de dos punteros
//   - Escribir un procedimiento intercambiar
//
vacio imprimirArreglo(entero [] a, entero n) {
    imprimir("[");
    para (entero i = 0; i < n; i++) {
        imprimir(a[i]);
        si (i < n - 1) {
            imprimir(", ");
        }
    }
    imprimir("]\n");
}

vacio intercambiar(entero [] a, entero i, entero j) {
    entero aux = a[i];
    a[i] = a[j];
    a[j] = aux;
}

vacio main() {
    entero [7] a = {1, 2, 3, 4, 5, 6, 7};
    entero i = 0;
    entero j = 6;
    // Los dos índices avanzan hacia el centro y se detienen al cruzarse.
    mientras (i < j) {
        intercambiar(a, i, j);
        imprimirArreglo(a, 7);
        i++;
        j--;
    }
}
