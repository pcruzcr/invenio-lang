// Nivel 4 · Ejercicio 04 — Búsqueda lineal
// Objetivos:
//   - Implementar la búsqueda secuencial
//   - Usar -1 como valor centinela de 'no encontrado'
//   - Ver que el peor caso recorre todo el arreglo
//
entero comparaciones = 0;

entero busquedaLineal(entero [] a, entero n, entero x) {
    para (entero i = 0; i < n; i++) {
        comparaciones++;
        si (a[i] == x) {
            retornar i;   // salida temprana
        }
    }
    retornar -1;   // no encontrado
}

vacio main() {
    entero [6] a = {16, 4, 42, 8, 23, 15};
    entero [3] buscados = {23, 4, 99};
    para_cada (entero x : buscados) {
        comparaciones = 0;
        entero p = busquedaLineal(a, 6, x);
        imprimir(x); imprimir(" -> "); imprimir(p);
        imprimir(" ("); imprimir(comparaciones); imprimir(" comparisons)\n");
    }
}
