// Nivel 8 · Ejercicio 01 — Mi primera clase
// Objetivos:
//   - Declarar una clase con atributos y métodos
//   - Crear objetos con nuevo y enviarles mensajes
//   - Ver que cada objeto tiene su propio estado
//
// Una clase es un molde: describe qué datos y qué comportamiento tendrá cada objeto.
clase Rectangulo {
    publico entero base;
    publico entero altura;

    Rectangulo(entero b, entero h) {
        este.base = b;
        este.altura = h;
    }

    publico entero area() {
        retornar este.base * este.altura;
    }

    publico entero perimetro() {
        retornar 2 * (este.base + este.altura);
    }

    publico vacio escalar(entero factor) {
        este.base = este.base * factor;
        este.altura = este.altura * factor;
    }
}

vacio main() {
    Rectangulo r1 = nuevo Rectangulo(3, 4);
    Rectangulo r2 = nuevo Rectangulo(5, 2);
    r2.escalar(3);
    imprimir("r1: "); imprimir(r1.area()); imprimir(" "); imprimir(r1.perimetro()); imprimir("\n");
    imprimir("r2: "); imprimir(r2.area()); imprimir(" "); imprimir(r2.perimetro()); imprimir("\n");
}
