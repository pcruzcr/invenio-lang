// Nivel 8 · Ejercicio 02 — Encapsulamiento: cuenta bancaria
// Objetivos:
//   - Ocultar el estado con privado
//   - Validar dentro de los métodos para mantener el objeto consistente
//   - Exponer lectura con un método obtenedor (getter)
//
clase CuentaBancaria {
    privado texto titular;
    privado entero saldo;

    CuentaBancaria(texto t) {
        este.titular = t;
        este.saldo = 0;
    }

    publico logico depositar(entero monto) {
        si (monto <= 0) {
            retornar falso;
        }
        este.saldo = este.saldo + monto;
        retornar verdadero;
    }

    publico logico retirar(entero monto) {
        // Invariante: el saldo nunca puede quedar negativo.
        si (monto <= 0 || monto > este.saldo) {
            retornar falso;
        }
        este.saldo = este.saldo - monto;
        retornar verdadero;
    }

    publico entero obtenerSaldo() {
        retornar este.saldo;
    }
}

vacio main() {
    CuentaBancaria c = nuevo CuentaBancaria("Ana");
    imprimir(c.depositar(500)); imprimir(" ");
    imprimir(c.depositar(-20)); imprimir(" ");
    imprimir(c.retirar(800)); imprimir(" ");
    imprimir(c.retirar(150)); imprimir("\n");
    imprimir("balance = "); imprimir(c.obtenerSaldo()); imprimir("\n");
}
