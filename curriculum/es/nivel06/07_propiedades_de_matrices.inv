// Nivel 6 · Ejercicio 07 — Propiedades: simétrica e identidad
// Objetivos:
//   - Verificar una propiedad sobre todos los elementos
//   - Salir en cuanto se encuentra un contraejemplo
//
constante entero N = 3;

logico esSimetrica(entero [][] m, entero n) {
    para (entero i = 0; i < n; i++) {
        para (entero j = 0; j < i; j++) {
            si (m[i][j] != m[j][i]) {
                retornar falso;   // contraejemplo encontrado
            }
        }
    }
    retornar verdadero;
}

logico esIdentidad(entero [][] m, entero n) {
    para (entero i = 0; i < n; i++) {
        para (entero j = 0; j < n; j++) {
            entero esperado = i == j ? 1 : 0;
            si (m[i][j] != esperado) {
                retornar falso;
            }
        }
    }
    retornar verdadero;
}

vacio main() {
    entero [N][N] I = {{1, 0, 0}, {0, 1, 0}, {0, 0, 1}};
    entero [N][N] S = {{2, 7, 3}, {7, 4, 5}, {3, 5, 6}};
    entero [N][N] X = {{1, 2, 3}, {4, 5, 6}, {7, 8, 9}};
    imprimir(esSimetrica(I, N)); imprimir(" "); imprimir(esIdentidad(I, N)); imprimir("\n");
    imprimir(esSimetrica(S, N)); imprimir(" "); imprimir(esIdentidad(S, N)); imprimir("\n");
    imprimir(esSimetrica(X, N)); imprimir(" "); imprimir(esIdentidad(X, N)); imprimir("\n");
}
