// Nivel 6 · Ejercicio 04 — Producto de matrices
// Objetivos:
//   - Implementar el producto fila por columna
//   - Verificar dimensiones compatibles
//
constante entero N = 3;

vacio imprimirMatriz(entero [][] m, entero filas, entero columnas) {
    para (entero i = 0; i < filas; i++) {
        para (entero j = 0; j < columnas; j++) {
            imprimir(m[i][j]);
            si (j < columnas - 1) {
                imprimir("\t");
            }
        }
        imprimir("\n");
    }
}

vacio multiplicar(entero [][] A, entero [][] B, entero [][] C, entero n, entero m, entero p) {
    // A es n x m, B es m x p y C será n x p.
    para (entero i = 0; i < n; i++) {
        para (entero j = 0; j < p; j++) {
            C[i][j] = 0;
            para (entero k = 0; k < m; k++) {
                C[i][j] += A[i][k] * B[k][j];
            }
        }
    }
}

vacio main() {
    entero [2][3] A = {{1, 2, 3}, {4, 5, 6}};
    entero [3][2] B = {{7, 8}, {9, 10}, {11, 12}};
    entero [2][2] C;
    multiplicar(A, B, C, 2, 3, 2);
    imprimirMatriz(C, 2, 2);
    entero [3][3] I = {{1, 0, 0}, {0, 1, 0}, {0, 0, 1}};
    entero [2][3] D;
    multiplicar(A, I, D, 2, 3, 3);
    imprimirMatriz(D, 2, 3);
}
