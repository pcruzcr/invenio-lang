// Nivel 6 · Ejercicio 05 — Matriz transpuesta
// Objetivos:
//   - Intercambiar filas por columnas
//   - Transponer en el lugar sin deshacer el trabajo
//
constante entero N = 3;

vacio imprimirMatriz(entero [][] m, entero filas, entero columnas) {
    para (entero i = 0; i < filas; i++) {
        para (entero j = 0; j < columnas; j++) {
            imprimir(m[i][j]);
            si (j < columnas - 1) {
                imprimir("\t");
            }
        }
        imprimir("\n");
    }
}

vacio main() {
    entero [2][3] M = {{1, 2, 3}, {4, 5, 6}};
    entero [3][2] T;
    para (entero i = 0; i < 2; i++) {
        para (entero j = 0; j < 3; j++) {
            T[j][i] = M[i][j];
        }
    }
    imprimirMatriz(T, 3, 2);
    entero [N][N] S = {{1, 2, 3}, {4, 5, 6}, {7, 8, 9}};
    para (entero i = 0; i < N; i++) {
        para (entero j = i + 1; j < N; j++) {   // solo el triángulo superior
            entero aux = S[i][j];
            S[i][j] = S[j][i];
            S[j][i] = aux;
        }
    }
    imprimirMatriz(S, N, N);
}
