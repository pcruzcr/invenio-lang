// Level 13 · Exercise 06 — Maximum subarray: O(n²) versus O(n)
// Learning goals:
//   - Redesign an algorithm to lower its order
//   - Check that both versions give the same result
//
// Linear congruential pseudo-random generator: always the same sequence,
// so the output is reproducible.
int seed = 7;

int nextRandom(int limit) {
    seed = (seed * 1103 + 12345) % 65536;
    return seed % limit;
}

int ops = 0;

int bruteForce(int [] a, int n) {
    int best = a[0];
    for (int i = 0; i < n; i++) {
        int sum = 0;
        for (int j = i; j < n; j++) {
            ops++;
            sum += a[j];
            if (sum > best) { best = sum; }
        }
    }
    return best;
}

int kadane(int [] a, int n) {
    int best = a[0];
    int current = a[0];
    for (int i = 1; i < n; i++) {
        ops++;
        // Either extend the previous subarray or start a new one at i.
        current = current + a[i] > a[i] ? current + a[i] : a[i];
        if (current > best) { best = current; }
    }
    return best;
}

void compare(int [] a, int n) {
    ops = 0;
    int r1 = bruteForce(a, n);
    int o1 = ops;
    ops = 0;
    int r2 = kadane(a, n);
    print("n="); print(n); print(" brute="); print(r1); print(" ("); print(o1); print(" ops)");
    print(" kadane="); print(r2); print(" ("); print(ops); print(" ops)\n");
}

void main() {
    int [9] a = {-2, 1, -3, 4, -1, 2, 1, -5, 4};
    compare(a, 9);
    int [200] b;
    for (int i = 0; i < 200; i++) {
        b[i] = nextRandom(21) - 10;
    }
    compare(b, 200);
}
