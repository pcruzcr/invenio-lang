// Level 5 · Exercise 08 — Sorting records with parallel arrays
// Learning goals:
//   - Keep parallel arrays in sync
//   - Understand sort stability
//   - Sort in descending order
//
void main() {
    string [5] names = {"Ana", "Luis", "Eva", "Juan", "Sofi"};
    int [5] points = {85, 92, 85, 70, 92};
    for (int i = 1; i < 5; i++) {
        int key = points[i];
        string keyName = names[i];
        int j = i - 1;
        while (j >= 0 && points[j] < key) {
            points[j + 1] = points[j];
            names[j + 1] = names[j];   // the name travels with its score
            j--;
        }
        points[j + 1] = key;
        names[j + 1] = keyName;
    }
    for (int i = 0; i < 5; i++) {
        print(i + 1); print(". "); print(names[i]); print(" "); print(points[i]); print("\n");
    }
}
