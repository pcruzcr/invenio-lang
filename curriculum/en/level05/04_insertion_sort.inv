// Level 5 · Exercise 04 — Insertion sort
// Learning goals:
//   - Implement insertion sort with shifts
//   - Relate it to sorting cards in your hand
//
void printArray(int [] a, int n) {
    print("[");
    for (int i = 0; i < n; i++) {
        print(a[i]);
        if (i < n - 1) {
            print(", ");
        }
    }
    print("]\n");
}

void swap(int [] a, int i, int j) {
    int tmp = a[i];
    a[i] = a[j];
    a[j] = tmp;
}

void main() {
    int [6] a = {12, 11, 13, 5, 6, 7};
    int n = 6;
    for (int i = 1; i < n; i++) {
        int key = a[i];
        int j = i - 1;
        while (j >= 0 && a[j] > key) {
            a[j + 1] = a[j];   // shift right
            j--;
        }
        a[j + 1] = key;
        print("key = "); print(key); print("  ");
        printArray(a, n);
    }
}
