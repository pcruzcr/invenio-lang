// Level 5 · Exercise 07 — Counting sort
// Learning goals:
//   - Sort without comparisons when the range is small
//   - Reuse the frequency array
//
void printArray(int [] a, int n) {
    print("[");
    for (int i = 0; i < n; i++) {
        print(a[i]);
        if (i < n - 1) {
            print(", ");
        }
    }
    print("]\n");
}

void swap(int [] a, int i, int j) {
    int tmp = a[i];
    a[i] = a[j];
    a[j] = tmp;
}

void main() {
    int [10] a = {4, 2, 7, 2, 9, 4, 0, 7, 7, 1};
    int [10] count;
    for (int v = 0; v < 10; v++) {
        count[v] = 0;
    }
    foreach (int x : a) {
        count[x] = count[x] + 1;
    }
    printArray(count, 10);
    // Rebuild: each value v is written count[v] times, in increasing order.
    int k = 0;
    for (int v = 0; v < 10; v++) {
        for (int r = 0; r < count[v]; r++) {
            a[k] = v;
            k++;
        }
    }
    printArray(a, 10);
}
