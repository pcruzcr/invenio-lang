// Level 7 · Exercise 02 — Reverse and detect palindromes
// Learning goals:
//   - Build a string by concatenation
//   - Normalize text before comparing it
//
string reverseText(string s) {
    string r = "";
    for (int i = text_length(s) - 1; i >= 0; i--) {
        r = r + char_at(s, i);
    }
    return r;
}

// Normalize: remove spaces and unify case before comparing.
string cleanText(string s) {
    string r = "";
    string lower = to_lower(s);
    for (int i = 0; i < text_length(lower); i++) {
        string c = char_at(lower, i);
        if (c != " ") {
            r = r + c;
        }
    }
    return r;
}

bool isPalindrome(string s) {
    string clean = cleanText(s);
    return clean == reverseText(clean);
}

void main() {
    string [3] sentences = {"Anita lava la tina", "Hola mundo", "Oso"};
    foreach (string f : sentences) {
        print(reverseText(f)); print(" | "); print(isPalindrome(f)); print("\n");
    }
    print(reverseText("abc") == reverse_string("abc")); print("\n");
}
