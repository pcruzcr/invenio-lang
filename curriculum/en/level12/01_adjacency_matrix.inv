// Level 12 · Exercise 01 — Adjacency matrix
// Learning goals:
//   - Represent a graph with a matrix
//   - Compute degrees and neighbors
//
const int N = 7;
int [N][N] adj;

void addEdge(int a, int b) {
    adj[a][b] = 1;
    adj[b][a] = 1;   // undirected: the relation goes both ways
}

void clearGraph() {
    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) {
            adj[i][j] = 0;
        }
    }
}

void main() {
    clearGraph();
    addEdge(0, 1);
    addEdge(0, 2);
    addEdge(1, 3);
    addEdge(2, 3);
    addEdge(3, 4);
    addEdge(4, 5);
    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) {
            print(adj[i][j]); print(" ");
        }
        print("\n");
    }
    int degreeSum = 0;
    for (int i = 0; i < N; i++) {
        int degree = 0;
        for (int j = 0; j < N; j++) {
            degree += adj[i][j];
        }
        print("deg("); print(i); print(")="); print(degree); print(" ");
        degreeSum += degree;
    }
    print("\n");
    print("neighbors(3):");
    for (int j = 0; j < N; j++) {
        if (adj[3][j] == 1) {
            print(" "); print(j);
        }
    }
    print("\n");
    print("edges = "); print(degreeSum / 2); print("\n");
}
