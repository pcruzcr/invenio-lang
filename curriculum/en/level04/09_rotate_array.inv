// Level 4 · Exercise 09 — Rotate an array
// Learning goals:
//   - Build a transformation out of a simpler one
//   - Work with subranges of an array
//
void printArray(int [] a, int n) {
    print("[");
    for (int i = 0; i < n; i++) {
        print(a[i]);
        if (i < n - 1) {
            print(", ");
        }
    }
    print("]\n");
}

void reverseArray(int [] a, int from, int to) {
    while (from < to) {
        int tmp = a[from];
        a[from] = a[to];
        a[to] = tmp;
        from++;
        to--;
    }
}

void main() {
    int [6] a = {10, 20, 30, 40, 50, 60};
    int n = 6;
    int k = 8 % n;   // rotating by 8 is the same as rotating by 2
    reverseArray(a, 0, k - 1);
    printArray(a, n);
    reverseArray(a, k, n - 1);
    printArray(a, n);
    reverseArray(a, 0, n - 1);
    printArray(a, n);
}
