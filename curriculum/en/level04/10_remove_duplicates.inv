// Level 4 · Exercise 10 — Remove duplicates from a sorted array
// Learning goals:
//   - Use a read index and a write index
//   - Tell array capacity from logical size
//
void printArray(int [] a, int n) {
    print("[");
    for (int i = 0; i < n; i++) {
        print(a[i]);
        if (i < n - 1) {
            print(", ");
        }
    }
    print("]\n");
}

int removeDuplicates(int [] a, int n) {
    if (n == 0) {
        return 0;
    }
    // write marks where the next distinct value goes; a[0] always stays.
    int write = 1;
    for (int i = 1; i < n; i++) {
        if (a[i] != a[write - 1]) {
            a[write] = a[i];
            write++;
        }
    }
    return write;
}

void main() {
    int [10] a = {1, 1, 2, 3, 3, 3, 4, 7, 7, 9};
    int newSize = removeDuplicates(a, 10);
    print("size = "); print(newSize); print("\n");
    printArray(a, newSize);
}
