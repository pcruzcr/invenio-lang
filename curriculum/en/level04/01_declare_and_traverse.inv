// Level 4 · Exercise 01 — Declare and traverse an array
// Learning goals:
//   - Declare and initialize arrays
//   - Traverse with indexes forward, backward and with steps
//
void printArray(int [] a, int n) {
    print("[");
    for (int i = 0; i < n; i++) {
        print(a[i]);
        if (i < n - 1) {
            print(", ");
        }
    }
    print("]\n");
}

const int N = 6;

void main() {
    int [N] data = {4, 8, 15, 16, 23, 42};
    printArray(data, N);
    // Reverse traversal: from the last index (N - 1) to the first (0).
    for (int i = N - 1; i >= 0; i--) {
        print(data[i]); print(" ");
    }
    print("\n");
    for (int i = 0; i < N; i = i + 2) {
        print("a["); print(i); print("] = "); print(data[i]); print("\n");
    }
}
