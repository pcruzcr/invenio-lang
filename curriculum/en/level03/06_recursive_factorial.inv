// Level 3 · Exercise 06 — Recursive factorial
// Learning goals:
//   - Identify the base case and the recursive case
//   - Visualize the call stack
//
void indent(int depth) {
    for (int i = 0; i < depth; i++) {
        print("  ");
    }
}

int factorialTrace(int n, int depth) {
    indent(depth); print("fact("); print(n); print(")\n");
    if (n == 0) {
        return 1;   // base case: stops the recursion
    }
    int r = n * factorialTrace(n - 1, depth + 1);
    indent(depth); print("= "); print(r); print("\n");
    return r;
}

int factorial(int n) {
    if (n == 0) {
        return 1;
    }
    return n * factorial(n - 1);   // the problem shrinks on each call
}

void main() {
    factorialTrace(4, 0);
    for (int i = 0; i <= 10; i++) {
        print(i); print("! = "); print(factorial(i)); print("\n");
    }
}
