// Level 1 · Exercise 06 — Operator precedence
// Learning goals:
//   - Apply precedence: unary, then * / %, then + -
//   - Use parentheses to change the order
//
void main() {
    // First 3 * 4 = 12; then 2 + 12.
    print(2 + 3 * 4); print("\n");
    print((2 + 3) * 4); print("\n");
    // 6 / 2 is evaluated before the subtraction.
    print(20 - 6 / 2); print("\n");
    print((20 - 6) / 2); print("\n");
    print(2 * 3 % 4); print("\n");
    print(-2 * -3); print("\n");
}
