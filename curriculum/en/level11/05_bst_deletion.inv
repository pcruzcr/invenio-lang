// Level 11 · Exercise 05 — BST deletion
// Learning goals:
//   - Tell the three deletion cases apart
//   - Preserve the BST property after deleting
//
class Node {
    public int value;
    public Node left;
    public Node right;
    Node(int v) { this.value = v; }
}

// Recursive insertion: returns the (possibly new) root of the subtree.
Node insert(Node r, int v) {
    if (r == null) {
        return new Node(v);
    }
    if (v < r.value) {
        r.left = insert(r.left, v);
    } else {
        if (v > r.value) {
            r.right = insert(r.right, v);
        }
    }
    return r;
}

void inOrder(Node r) {
    if (r != null) {
        inOrder(r.left);
        print(r.value); print(" ");
        inOrder(r.right);
    }
}

Node deleteNode(Node r, int v) {
    if (r == null) {
        return null;
    }
    if (v < r.value) {
        r.left = deleteNode(r.left, v);
        return r;
    }
    if (v > r.value) {
        r.right = deleteNode(r.right, v);
        return r;
    }
    // Found. Cases 1 and 2: zero or one child.
    if (r.left == null) {
        return r.right;
    }
    if (r.right == null) {
        return r.left;
    }
    // Case 3: two children. The successor is the minimum of the right subtree.
    Node successor = r.right;
    while (successor.left != null) {
        successor = successor.left;
    }
    r.value = successor.value;
    r.right = deleteNode(r.right, successor.value);
    return r;
}

void main() {
    int [7] data = {50, 30, 70, 20, 40, 60, 80};
    Node root = null;
    foreach (int v : data) {
        root = insert(root, v);
    }
    int [3] toDelete = {20, 30, 50};
    foreach (int v : toDelete) {
        root = deleteNode(root, v);
        print("-"); print(v); print(": "); inOrder(root);
        print("(root "); print(root.value); print(")\n");
    }
}
