// floyd.inv - Floyd-Warshall O(V^3), todos contra todos, V=4.
const int N = 4;
const int INF = 999;

void main() {
    int [N][N] d;
    para (int i = 0; i < N; i++) {
        para (int j = 0; j < N; j++) {
            si (i == j) { d[i][j] = 0; } sino { d[i][j] = INF; }
        }
    }
    d[0][1] = 3; d[0][3] = 7;
    d[1][0] = 8; d[1][2] = 2;
    d[2][0] = 5; d[2][3] = 1;
    d[3][0] = 2;
    para (int k = 0; k < N; k++) {
        para (int i = 0; i < N; i++) {
            para (int j = 0; j < N; j++) {
                si (d[i][k] + d[k][j] < d[i][j]) { d[i][j] = d[i][k] + d[k][j]; }
            }
        }
    }
    imprimir("floyd:");
    para (int i = 0; i < N; i++) {
        para (int j = 0; j < N; j++) {
            imprimir(" "); imprimir(d[i][j]);
        }
    }
    imprimir("\n");
}
